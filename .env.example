# --- Supabase (https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://chooseproperty.in
NEXT_PUBLIC_SITE_NAME=Choose Property

# --- Client contact (shown publicly) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_PHONE_NUMBER=+91 99999 99999
NEXT_PUBLIC_WHATSAPP_MESSAGE_PREFIX=Hello Choose Property,

# --- Google Maps (optional, for embedded maps) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
